{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "jsPlugins": ["@totto2727/oxlint"],
  "categories": {},
  "rules": {
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "rules/no-eslint-disable-comments": "error",
    "rules/no-import-from-barrel-package": "error",
    "rules/no-jsx-script-tag": "error",
    "rules/require-disable-reason": "error"
  },
  "settings": {
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": ["dist", "node_modules", "/catalog", "deploy/helm/open-connector/templates"]
}
